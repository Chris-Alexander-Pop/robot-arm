// WiFi credentials and log-hub network config.
//
// Copy this file to wifi_config.h and fill in your values.
// wifi_config.h is listed in .gitignore to avoid committing credentials.
//
// Alternatively, pass them as PlatformIO build flags:
//   build_flags = ... -DWIFI_SSID="MyNet" -DWIFI_PASS="secret" -DLOG_HOST_IP="192.168.1.100"

#pragma once

#ifndef WIFI_SSID
#define WIFI_SSID "YOUR_WIFI_SSID"
#endif

#ifndef WIFI_PASS
#define WIFI_PASS "YOUR_WIFI_PASSWORD"
#endif

// PC / host IP where rs485_log_hub.py is listening.
#ifndef LOG_HOST_IP
#define LOG_HOST_IP "192.168.1.100"
#endif

// UDP port must match LOG_UDP_PORT in rs485_log_hub.py (default 9000).
#ifndef LOG_UDP_PORT
#define LOG_UDP_PORT 9000
#endif
