# RS-485 bench hub configuration
# Copy this file to rs485_bench.env and fill in your values.
# Source it before running the hub:   source rs485_bench.env
#
# The hub script reads these environment variables if set;
# they supplement (not replace) command-line flags.

# Your WiFi AP credentials — used when building ESP32-C3 firmware.
# These are NOT used by the Python hub directly; they go into platformio.ini
# or wifi_config.h in the rs485_esp32_bench project.
WIFI_SSID="YOUR_SSID"
WIFI_PASS="YOUR_PASSWORD"

# IP address of the PC running rs485_log_hub.py on the bench network.
# Each ESP32-C3 node will send UDP datagrams to this address.
LOG_HOST_IP="192.168.1.100"

# UDP port — must match LOG_UDP_PORT in platformio.ini (default 9000).
LOG_UDP_PORT=9000

# Pico serial port — set if auto-detection fails.
# PICO_PORT=/dev/ttyACM0
