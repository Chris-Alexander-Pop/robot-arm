.tooling/
.venv/

# Python caches and test output
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage*
htmlcov/
.ipynb_checkpoints/

# OS junk
.DS_Store
Thumbs.db

# SolidWorks: lock files when a file is open (~$name.SLDXXX)
~$*

# KiCad lock files
*.lck

# KiCad local history / recovery snapshots (not the canonical schematic;
# may duplicate *.kicad_sch and should not be shared). Ignore entirely.
**/.history/

# KiCad automatic project backups (timestamped copies beside the project)
**/*-backups/

# KiCad regenerated footprint library cache (machine-local)
**/fp-info-cache

# Local/generated reports and snapshots
log.html
report.html
robot_output.xml
logs/
snapshots/
*.save

# ROS/colcon artifacts
software/ros2_ws/build/
software/ros2_ws/install/
software/ros2_ws/log/

# Top-level/local colcon logs
log/
.log/

# Generic log files
*.log

# PlatformIO: compile_commands.json from `pio run -t compiledb` (large, regenerated locally)
firmware/stm32_core/compile_commands.json