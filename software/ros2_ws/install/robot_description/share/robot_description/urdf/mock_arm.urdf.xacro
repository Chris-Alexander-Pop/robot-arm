<?xml version="1.0"?>
<robot name="mock_arm" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- A basic white material -->
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <!-- A basic blue material to alternate colors and make it easier to see joints -->
  <material name="blue">
    <color rgba="0.2 0.2 0.8 1"/>
  </material>

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
      <material name="white"/>
    </visual>
  </link>

  <!-- Joint 1 (Base Rotation / Yaw) -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>

  <!-- Link 1 (Shoulder vertical post) -->
  <link name="link1">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.04"/>
      </geometry>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Joint 2 (Shoulder Pitch) -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.15" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/> <!-- Rotates around Z because we rotated the joint origin by 90 deg (1.57 rad) in Y -->
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <!-- Link 2 (Upper Arm) -->
  <link name="link2">
    <visual>
      <geometry>
        <cylinder length="0.2" radius="0.035"/>
      </geometry>
      <origin xyz="0 0.1 0" rpy="1.5708 0 0"/>
      <material name="white"/>
    </visual>
  </link>

  <!-- Joint 3 (Elbow Pitch) -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0.2 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <!-- Link 3 (Forearm) -->
  <link name="link3">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
      <origin xyz="0 0.075 0" rpy="1.5708 0 0"/>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Joint 4 (Wrist Pitch) -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0.15 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <!-- Link 4 (Wrist) -->
  <link name="link4">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.035"/>
      </geometry>
      <origin xyz="0 0.025 0" rpy="1.5708 0 0"/>
      <material name="white"/>
    </visual>
  </link>

  <!-- Joint 5 (Wrist Roll) -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0.05 0" rpy="0 0 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>

  <!-- Link 5 (End Effector Base) -->
  <link name="link5">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
      <origin xyz="0 0.02 0" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Joint 6 (End Effector Roll) -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0.04 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>

  <!-- Link 6 (End Effector) -->
  <link name="link6">
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.01"/>
      </geometry>
      <origin xyz="0 0.04 0" rpy="1.5708 0 0"/>
      <material name="white"/>
    </visual>
  </link>

</robot>
